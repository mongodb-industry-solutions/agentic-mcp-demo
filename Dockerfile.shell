FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Bootstrap uv (needed before requirements install)
RUN pip install uv

WORKDIR /app

# Create a venv that uv run will auto-discover when spawning MCP subprocesses.
# Setting VIRTUAL_ENV tells uv which venv to use without a pyproject.toml.
RUN python -m venv .venv
ENV VIRTUAL_ENV="/app/.venv"
ENV PATH="/app/.venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Kanopy requires port 8080. The uvicorn.run() in web/shell.py is guarded
# by `if __name__ == "__main__"` so this CMD overrides it cleanly.
EXPOSE 8080
CMD ["uvicorn", "web.shell:app", "--host", "0.0.0.0", "--port", "8080", "--log-level", "info"]
