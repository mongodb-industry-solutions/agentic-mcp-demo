  "type": "output_validation",
  "action": "modify",
  "status": "active",
  "stage_filter": ["llm_output"],
  "workspace_ids": [
    "ws-6af1e8a9a1058b3d57ec3b7e",
    "ws-6af1e8a9a1058b3d57ec3b80",
    "ws-6af1e8a9a1058b3d57ec3b82"
  ],
  "config": {
    "match_patterns": [
      {"type": "regex", "value": "\\d{15}"},
      {"type": "regex", "value": "\\+[1-9]\\d{7,14}"}
